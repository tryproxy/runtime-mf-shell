    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "7",
    "shadcn": "^4.13.1",
