VITE_API_BASE_URL=/api
# Production example:
# VITE_REMOTE_ENTRY_URL=https://runtime-mf-module.vercel.app/assets/remoteEntry.js
VITE_REMOTE_ENTRY_URL=http://localhost:5001/assets/remoteEntry.js
# Angular remote (runtime-mf-module-angular), default port 5002
VITE_ANGULAR_REMOTE_ENTRY_URL=http://localhost:5002/assets/remoteEntry.js

# PoC-only: shell derives each remote's nav.json as `{origin}/nav.json` from the
# remoteEntry URL above (e.g. http://localhost:5001/nav.json). Production must
# not rely on this derivation — use an explicit manifest URL instead.
