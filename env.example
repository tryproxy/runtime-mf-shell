VITE_API_BASE_URL=/api
# Production values for the shell's Vercel project:
# VITE_REMOTE_MANIFEST_URL=https://runtime-mf-module.vercel.app/mf-manifest.json
# VITE_ANGULAR_REMOTE_MANIFEST_URL=https://runtime-mf-module-angular.vercel.app/mf-manifest.json

# Local development:
VITE_REMOTE_MANIFEST_URL=http://localhost:5001/mf-manifest.json
VITE_ANGULAR_REMOTE_MANIFEST_URL=http://localhost:5002/mf-manifest.json

# ASO: unset falls back to http://localhost:5003/mf-manifest.json in
# remote-runtime-composition and remote-nav-sources. Override for a
# deployed artifact. `/aso` is always registered; it is not omitted when
# this variable is missing.
# VITE_ASO_REMOTE_MANIFEST_URL=http://localhost:5003/mf-manifest.json
# VITE_ASO_API_BASE_URL=https://dev...

# There is no starter env var. runtime-mf-react-remote-starter (:5004) is
# not registered in this shell.

# PoC-only: shell derives each remote's nav.json as `{origin}/nav.json` from the
# federation manifest URL above (e.g. http://localhost:5001/nav.json). Production must
# not rely on this derivation — use an explicit manifest URL instead.

# Playwright host E2E (not Vite). See e2e/README.md.
# Dummy e2e-local is loopback UI-guard only. Deployed URLs and
# E2E_PROTECTED_API=1 require E2E_ACCESS_TOKEN or E2E_EMAIL+E2E_PASSWORD.
# E2E_ACCESS_TOKEN=
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_PROTECTED_API=
